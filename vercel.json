{
  "trailingSlash": false,
  "redirects": [
    { "source": "/deep-cleaning-services", "destination": "/deep-cleaning", "permanent": true },
    { "source": "/deep-cleaning-services/", "destination": "/deep-cleaning", "permanent": true },
    { "source": "/house-cleaning-services-springboro-ohio", "destination": "/locations/springboro/house-cleaning-services", "permanent": true },
    { "source": "/house-cleaning-services-springboro-ohio/", "destination": "/locations/springboro/house-cleaning-services", "permanent": true },
    { "source": "/house-cleaning-services-dayton-ohio", "destination": "/locations/dayton/house-cleaning-services", "permanent": true },
    { "source": "/house-cleaning-services-dayton-ohio/", "destination": "/locations/dayton/house-cleaning-services", "permanent": true },
    { "source": "/dayton-house-cleaning-services", "destination": "/locations/dayton/house-cleaning-services", "permanent": true },
    { "source": "/dayton-house-cleaning-services/", "destination": "/locations/dayton/house-cleaning-services", "permanent": true },
    { "source": "/contact-us", "destination": "/quote", "permanent": true },
    { "source": "/contact-us/", "destination": "/quote", "permanent": true },
